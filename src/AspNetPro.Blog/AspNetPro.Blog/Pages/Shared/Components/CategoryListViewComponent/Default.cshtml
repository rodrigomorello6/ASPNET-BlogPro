@model IEnumerable<CategoryListItem>

<section>
    <div class="card mb-4">
        <div class="card-header">Categories</div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-page="/Posts/Index" asp-route-category="@item.Permalink" class="text-decoration-none">
                            @item.Name (@item.TotalPosts)
                        </a>
                        <span class="badge bg-secondary">@item.TotalPosts</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>
