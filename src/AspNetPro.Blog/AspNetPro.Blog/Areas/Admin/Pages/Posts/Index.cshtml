
@page "/admin/posts"
@model AspNetPro.Blog.Areas.Admin.Pages.Posts.IndexModel
@{
    ViewData["Title"] = "Listagem de Posts";
}

<header class="page-header page-header-compact page-header-light border-bottom bg-white mb-4">
    <div class="container-xl px-4">
        <div class="page-header-content">
            <div class="row align-items-center justify-content-between pt-3">
                <div class="col-auto mb-3">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i data-feather="file"></i></div>
                        @ViewData["Title"]
                    </h1>
                </div>
                <div class="col-12 col-xl-auto mb-3">
                    <a class="btn btn-primary" asp-page="/Posts/Add">
                        <svg xmlns="http//www.w3.org/2000/svg" with="24" height="24" viewBox="0 0 24 24" />
                            Create New Post
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-xl px-4 mt-4">
    <div class="card">
        <div class="card-body">
             
            <table id="posts-table" class="table table-striped table-bordered table-over">
                <thead>
                    <th>Title</th>
                    <th>Published On</th>
                    <th>Action</th>
                </thead>
                @foreach (var item in Model.Posts)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.PublishedOn</td>
                        <td>
                            <a class="btn btn-primary btn-sm" asp-page="/Posts/Edit" asp-route-postid="@item.PostId" >Edit</a>
                            &nbsp;
                            <a class="btn btn-danger btn-sm" asp-page="/Posts/Delete" asp-route-postid="@item.PostId">Delete</a>

                        </td>
                    </tr>
                }
            </table>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js" crossorigin="anonymous"></script>
    <script>
        window.addEventListener('DOMContentLoaded', function(){
            var postsTable = document.getElementById('posts-table');
            if (postsTable) {
            new simpleDatatables.DataTable(postsTable);
            }
        });

    </script>
}